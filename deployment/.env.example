# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.

# Docker image tag (overrides the default "latest" in docker-compose.yml)
# IMAGE_TAG=latest

# ─── Zugriffskontrolle für POST-Routen (KI-Vorschau ausloesen, Parameter aendern) ────────────
# Erzeugen: openssl passwd -apr1 'passwort'   (jedes $ im Hash als $$ schreiben, siehe DEPLOYMENT.md)
BASIC_AUTH_USERS=alice:$$apr1$$XXXXXXXX$$YYYYYYYYYYYYYYYYYYYYYYYY0

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
MATCHORACLE_DB_PASSWORD=changeme

# ─── Anthropic (claude-sonnet-5) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-api-key

# ─── Umami (Besucherstatistik, stats.rasen-radar.de) ──────────────────────────
# Erzeugen: openssl rand -hex 32   (beide Werte, je einmal)
UMAMI_APP_SECRET=replace-me
UMAMI_TWO_FACTOR_KEY=replace-me
# Leer lassen, bis die Website im Umami-Dashboard angelegt ist — danach die dortige
# Website-ID eintragen und den Stack neu starten (siehe DEPLOYMENT.md).
UMAMI_WEBSITE_ID=
