# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.

# Docker image tag (overrides the default "latest" in docker-compose.yml)
# IMAGE_TAG=latest

# ─── Zugriffskontrolle für POST-Routen (KI-Vorschau ausloesen, Parameter aendern) ────────────
# Erzeugen: openssl passwd -apr1 'passwort'   (jedes $ im Hash als $$ schreiben, siehe DEPLOYMENT.md)
BASIC_AUTH_USERS=alice:$$apr1$$XXXXXXXX$$YYYYYYYYYYYYYYYYYYYYYYYY0

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
MATCHORACLE_DB_PASSWORD=changeme

# ─── Anthropic (claude-sonnet-5) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-api-key
